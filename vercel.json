{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    { "source": "/services", "destination": "/our-work", "permanent": true },
    { "source": "/services/", "destination": "/our-work", "permanent": true },
    { "source": "/team", "destination": "/people", "permanent": true },
    { "source": "/team/", "destination": "/people", "permanent": true }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
