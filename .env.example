# Copy to .env for local development. Do not commit .env.
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-the-superuser-password

# Optional. When unset, content is stored in data/cms.json.
# DATABASE_URL=postgres://user:password@host:5432/gpp

# Optional. When unset, enquiries are stored and the form still confirms.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Global Place Partners <onboarding@resend.dev>
# CONTACT_TO_EMAILS=enquiries@globalplacepartners.com

# Cloudflare Turnstile. Defaults are the official always-pass test keys.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
